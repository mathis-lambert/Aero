    "%@ encrypts them so no other app can read them. Each of its profiles becomes a space." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ les chiffre pour qu’aucune autre app ne puisse les lire. Chacun de ses profils devient un espace."
          }
        }
      }
    },
