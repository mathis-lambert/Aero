    },
    "Changes since that snapshot will be replaced, including tabs, permissions and extension settings. Current files will be preserved separately. Browsing history is not restored." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes since that snapshot will be replaced, including tabs, permissions and extension settings. Current files will be preserved separately. Browsing history is not restored."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modifications effectuées depuis cette sauvegarde seront remplacées, notamment les onglets, les autorisations et les réglages des extensions. Les fichiers actuels seront conservés séparément. L’historique de navigation ne sera pas restauré."
          }
        }
      }
    },
