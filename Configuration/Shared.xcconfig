SWIFT_EMIT_LOC_STRINGS = YES
SWIFT_GENERATE_LOCALIZATION_SYMBOLS = NO
// The pre-signing phase validates Xcode and removes Finder's custom icon from build products.
ENABLE_USER_SCRIPT_SANDBOXING = NO
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Configuration/Info.plist
ENABLE_HARDENED_RUNTIME = YES
CODE_SIGN_ENTITLEMENTS = Configuration/Aero.entitlements
// One module name for Aero and Aero Dev, so unit tests import it the same way.
PRODUCT_MODULE_NAME = Aero
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
#include "Version.xcconfig"
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
// Only the signed distribution script enables the updater and supplies its public key. The stable feed is Sparkle's
// default; the channel the person chooses picks the feed at run time (docs/UPDATES.md).
AERO_UPDATES_ENABLED = NO
SPARKLE_PUBLIC_ED_KEY =
